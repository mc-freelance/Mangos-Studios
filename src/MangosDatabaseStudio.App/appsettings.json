{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "127.0.0.1",
    "MySql": {
        "CommandTimeoutSeconds": 60,
        "MaximumBrowsePageSize": 250,
        "MaximumSqlRows": 1000,
        "ImportClientPath": "mysql",
        "ExportClientPath": "mysqldump"
    }
}
