@* Present the WorldEditor Quests workflow within the shared studio layout. *@

@using System.Globalization
@using MangosDatabaseStudio.Domain.World
@model QuestViewerViewModel
@{
    ViewData["Title"] = "Quest Viewer";
    ViewData["Section"] = Model.Database + " / " + Model.CatalogName;
    ViewData["PageClass"] = "world-editor-page";
    ViewData["ContentClass"] = "world-editor-content world-record-editor-content";

    int[] pageSizes = new[] { 10, 20, 50, 100, 200 };
    int firstPage = Math.Max(1, Model.Quests.Page - 2);
    int lastPage = Math.Min(Model.Quests.TotalPages, Model.Quests.Page + 2);
    int relationFirstPage = Model.SelectedQuest == null ? 1 : Math.Max(1, Model.SelectedQuest.Relations.Page - 2);
    int relationLastPage = Model.SelectedQuest == null ? 1 : Math.Min(Model.SelectedQuest.Relations.TotalPages, Model.SelectedQuest.Relations.Page + 2);
    bool canManage = Model.CanEditQuests || Model.CanDeleteQuests || Model.CanAddRelations || Model.CanEditRelations || Model.CanRemoveRelations;
    string questLookupUrl = Url.Action("QuestOptions", "WorldEditor") ?? string.Empty;
}

<div class="world-record-editor viewer-page" data-quest-viewer>
    <header class="record-editor-commandbar">
        <div class="record-command-identity">
            <a class="record-back-button" asp-action="Index" asp-route-database="@Model.Database" aria-label="Back to World Editor"><i class="bi bi-arrow-left"></i></a>
            <span class="record-command-icon"><i class="bi bi-journal-text"></i></span>
            <div>
                <span class="eyebrow">Structured world data viewer</span>
                <h2>Quest Viewer</h2>
                <p>Inspect quest definitions, chain relationships, and the creatures or GameObjects that start and end them.</p>
            </div>
        </div>
        <div class="record-command-actions">
            <span class="record-change-badge"><i class="bi @(canManage ? "bi-pencil-square" : "bi-shield-check")"></i> @(canManage ? "Quest editor" : "Read-only")</span>
            @if (Model.IsAvailable && Model.CanAddRelations && Model.EditorCapabilities.RelationKinds.Count > 0)
            {
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#questAddExistingModal">
                    <i class="bi bi-plus-lg"></i> Add existing quest
                </button>
            }
        </div>
    </header>

    <div class="viewer-flow">
        <section class="panel viewer-search-panel" aria-labelledby="questDirectoryHeading">
            <header class="panel-header viewer-search-heading">
                <div>
                    <span class="eyebrow">Quest directory</span>
                    <h2 id="questDirectoryHeading">Find a quest</h2>
                    <p>Search by quest entry or title, then open it to inspect its chain and world relationships.</p>
                </div>
                <span class="viewer-catalog-badge"><i class="bi bi-database-check"></i> @Model.CatalogName @Model.CatalogVersion</span>
            </header>

            @if (!Model.IsAvailable)
            {
                <div class="alert alert-warning studio-inline-alert mb-0">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>
                        <strong>Quest Viewer unavailable</strong>
                        <span>The connected world database does not expose quest_template.</span>
                    </div>
                </div>
            }
            else
            {
                <form method="get" asp-action="Quests" class="viewer-search-form">
                    <input type="hidden" name="database" value="@Model.Database" />
                    <input type="hidden" name="show" value="true" />
                    <input type="hidden" name="pageSize" value="@Model.Quests.PageSize" />
                    <label class="viewer-search-field" for="questSearch">
                        <span>Quest entry or title</span>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input id="questSearch" type="search" name="search" class="form-control" value="@Model.Search" placeholder="Example: 783 or A Threat Within" autocomplete="off" />
                        </div>
                        <small>The directory query searches quest_template first; relation counts are loaded only for the current page.</small>
                    </label>
                    <div class="viewer-context-card">
                        <span class="viewer-context-icon"><i class="bi bi-diagram-3"></i></span>
                        <div>
                            <small>Relationship storage</small>
                            <strong>@Model.EditorCapabilities.RelationStorageLabel</strong>
                            <span>@Model.EditorCapabilities.RelationKinds.Count supported creature/GameObject role@(Model.EditorCapabilities.RelationKinds.Count == 1 ? string.Empty : "s") detected.</span>
                        </div>
                    </div>
                    <div class="viewer-context-card">
                        <span class="viewer-context-icon"><i class="bi @(canManage ? "bi-pencil-square" : "bi-shield-check")"></i></span>
                        <div>
                            <small>Workspace access</small>
                            <strong>@(canManage ? "Quest management enabled" : "Read-only viewer")</strong>
                            <span>Quest rows and their starter/ender relationships follow your World Editor permissions.</span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary viewer-search-button"><i class="bi bi-search"></i> Search quests</button>
                </form>
            }
        </section>

        @if (Model.IsAvailable && Model.HasSearched)
        {
            <section class="viewer-summary-grid" aria-label="Quest viewer summary">
                <article class="panel viewer-summary-card">
                    <span><i class="bi bi-journal-text"></i></span>
                    <div>
                        <small>Matching quests</small>
                        <strong>@Model.Quests.TotalCount.ToString("N0")</strong>
                        <p>@(string.IsNullOrWhiteSpace(Model.Search) ? "All quest templates" : "Search applied")</p>
                    </div>
                </article>
                <article class="panel viewer-summary-card">
                    <span><i class="bi bi-file-earmark-text"></i></span>
                    <div>
                        <small>Directory page</small>
                        <strong>@Model.Quests.Page / @Math.Max(Model.Quests.TotalPages, 1)</strong>
                        <p>@Model.Quests.PageSize rows per page</p>
                    </div>
                </article>
                <article class="panel viewer-summary-card">
                    <span><i class="bi bi-signpost-split"></i></span>
                    <div>
                        <small>Current selection</small>
                        @if (Model.SelectedQuest == null)
                        {
                            <strong>None</strong>
                            <p>Select a quest below</p>
                        }
                        else
                        {
                            <strong>Quest @Model.SelectedQuest.Quest.Entry</strong>
                            <p>@Model.SelectedQuest.Quest.TotalRelationCount.ToString("N0") world relationship@(Model.SelectedQuest.Quest.TotalRelationCount == 1 ? string.Empty : "s")</p>
                        }
                    </div>
                </article>
                <article class="panel viewer-summary-card">
                    <span><i class="bi bi-link-45deg"></i></span>
                    <div>
                        <small>Relation schema</small>
                        <strong>@Model.EditorCapabilities.RelationKinds.Count role@(Model.EditorCapabilities.RelationKinds.Count == 1 ? string.Empty : "s")</strong>
                        <p>@Model.EditorCapabilities.RelationStorageLabel</p>
                    </div>
                </article>
            </section>
        }

        <main class="viewer-detail-stack">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            }

            @if (!Model.IsAvailable)
            {
                <section class="panel viewer-empty-state is-warning">
                    <span><i class="bi bi-database-exclamation"></i></span>
                    <h3>quest_template was not found</h3>
                    <p>The Quest Viewer requires quest_template. Starter and ender relation tables are detected independently when available.</p>
                </section>
            }
            else if (!Model.HasSearched)
            {
                <section class="panel viewer-empty-state">
                    <span><i class="bi bi-journal-text"></i></span>
                    <h3>Trace a quest from definition to world source</h3>
                    <p>Search the quest directory to inspect chain fields, related quests, creature starters/enders, and GameObject starters/enders.</p>
                </section>
            }
            else if (Model.Quests.Items.Count == 0)
            {
                <section class="panel viewer-empty-state">
                    <span><i class="bi bi-search"></i></span>
                    <h3>No matching quests</h3>
                    <p>No quest_template rows match the current entry or title search.</p>
                </section>
            }
            else if (Model.SelectedQuest == null)
            {
                <section class="panel viewer-panel-flush viewer-results-panel">
                    <header class="viewer-results-header">
                        <div>
                            <span class="eyebrow">Quest search results</span>
                            <h3>Choose a quest</h3>
                            <p>Each row summarizes levels, direct chain references, and world starter/ender relationships before you open it.</p>
                        </div>
                        <div class="viewer-results-count">
                            <strong>@Model.Quests.TotalCount.ToString("N0")</strong>
                            <span>quest@(Model.Quests.TotalCount == 1 ? string.Empty : "s")</span>
                        </div>
                    </header>

                    <form method="get" asp-action="Quests" class="world-filter-bar viewer-results-toolbar">
                        <input type="hidden" name="database" value="@Model.Database" />
                        <input type="hidden" name="search" value="@Model.Search" />
                        <input type="hidden" name="show" value="true" />
                        <span class="world-filter-hint">Page @Model.Quests.Page of @Math.Max(Model.Quests.TotalPages, 1)</span>
                        <label class="world-filter-select">
                            <span>Rows per page</span>
                            <select name="pageSize" class="form-select" onchange="this.form.submit()">
                                @foreach (int size in pageSizes)
                                {
                                    if (Model.Quests.PageSize == size) { <option value="@size" selected>@size</option> }
                                    else { <option value="@size">@size</option> }
                                }
                            </select>
                        </label>
                    </form>

                    <div class="world-record-table-wrap viewer-results-table-wrap">
                        <table class="table studio-table viewer-results-table viewer-directory-table mb-0" aria-label="Quest search results">
                            <colgroup>
                                <col class="viewer-directory-col" style="--viewer-col-width:34%" />
                                <col class="viewer-directory-col" style="--viewer-col-width:10%" />
                                <col class="viewer-directory-col" style="--viewer-col-width:18%" />
                                <col class="viewer-directory-col" style="--viewer-col-width:15%" />
                                <col class="viewer-directory-col" style="--viewer-col-width:15%" />
                                <col class="viewer-directory-col" style="--viewer-col-width:8%" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Quest</th>
                                    <th class="viewer-directory-center">Level</th>
                                    <th class="viewer-directory-center">Chain</th>
                                    <th class="viewer-directory-center">Starters</th>
                                    <th class="viewer-directory-center">Enders</th>
                                    <th class="actions-column viewer-action-column viewer-directory-center">Open</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (QuestSummary quest in Model.Quests.Items)
                            {
                                string title = string.IsNullOrWhiteSpace(quest.Title) ? "Unnamed quest" : quest.Title;
                                <tr>
                                    <td class="viewer-directory-name-cell">
                                        <div class="viewer-directory-identity">
                                            <span class="viewer-directory-icon"><i class="bi bi-journal-text"></i></span>
                                            <span>
                                                <strong>@title</strong>
                                                <small>Entry @quest.Entry</small>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="viewer-directory-center">
                                        <div class="viewer-resolved-entity">
                                            <strong>@(quest.QuestLevel?.ToString(CultureInfo.InvariantCulture) ?? "—")</strong>
                                            <small>Minimum @(quest.MinLevel?.ToString(CultureInfo.InvariantCulture) ?? "—")</small>
                                        </div>
                                    </td>
                                    <td class="viewer-directory-center">
                                        <div class="viewer-composition-chips">
                                            @if (quest.PrevQuestId != 0)
                                            {
                                                <span><i class="bi bi-arrow-left"></i> @quest.PrevQuestId</span>
                                            }
                                            @if (quest.NextQuestId != 0 || quest.NextQuestInChain != 0)
                                            {
                                                <span><i class="bi bi-arrow-right"></i> @(quest.NextQuestInChain != 0 ? quest.NextQuestInChain : quest.NextQuestId)</span>
                                            }
                                            @if (quest.PrevQuestId == 0 && quest.NextQuestId == 0 && quest.NextQuestInChain == 0)
                                            {
                                                <span class="is-empty">No direct chain</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="viewer-directory-center">
                                        <div class="viewer-resolved-entity">
                                            <strong>@quest.StarterCount.ToString("N0")</strong>
                                            <small>@quest.CreatureStarterCount C / @quest.GameObjectStarterCount GO</small>
                                        </div>
                                    </td>
                                    <td class="viewer-directory-center">
                                        <div class="viewer-resolved-entity">
                                            <strong>@quest.EnderCount.ToString("N0")</strong>
                                            <small>@quest.CreatureEnderCount C / @quest.GameObjectEnderCount GO</small>
                                        </div>
                                    </td>
                                    <td class="actions-column viewer-action-column viewer-directory-center">
                                        <a class="icon-button"
                                           asp-action="Quests"
                                           asp-route-database="@Model.Database"
                                           asp-route-search="@Model.Search"
                                           asp-route-show="true"
                                           asp-route-entry="@quest.Entry"
                                           asp-route-page="@Model.Quests.Page"
                                           asp-route-pageSize="@Model.Quests.PageSize"
                                           title="Open quest @quest.Entry"
                                           aria-label="Open quest @quest.Entry">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.Quests.TotalPages > 1)
                    {
                        <nav class="pagination-shell world-pagination viewer-results-pagination" aria-label="Quest result pages">
                            <div class="pagination-status">
                                <strong>Page @Model.Quests.Page</strong>
                                <span>of @Model.Quests.TotalPages · @Model.Quests.TotalCount.ToString("N0") quests</span>
                            </div>
                            <ul class="pagination mb-0">
                                <li class="page-item pagination-direction @(Model.Quests.Page == 1 ? "disabled" : string.Empty)">
                                    <a class="page-link"
                                       asp-action="Quests"
                                       asp-route-database="@Model.Database"
                                       asp-route-search="@Model.Search"
                                       asp-route-show="true"
                                       asp-route-page="@(Model.Quests.Page - 1)"
                                       asp-route-pageSize="@Model.Quests.PageSize">
                                        <i class="bi bi-chevron-left"></i><span>Previous</span>
                                    </a>
                                </li>
                                @for (int pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                                {
                                    <li class="page-item @(pageNumber == Model.Quests.Page ? "active" : string.Empty)">
                                        <a class="page-link"
                                           asp-action="Quests"
                                           asp-route-database="@Model.Database"
                                           asp-route-search="@Model.Search"
                                           asp-route-show="true"
                                           asp-route-page="@pageNumber"
                                           asp-route-pageSize="@Model.Quests.PageSize">@pageNumber</a>
                                    </li>
                                }
                                <li class="page-item pagination-direction @(Model.Quests.Page == Model.Quests.TotalPages ? "disabled" : string.Empty)">
                                    <a class="page-link"
                                       asp-action="Quests"
                                       asp-route-database="@Model.Database"
                                       asp-route-search="@Model.Search"
                                       asp-route-show="true"
                                       asp-route-page="@(Model.Quests.Page + 1)"
                                       asp-route-pageSize="@Model.Quests.PageSize">
                                        <span>Next</span><i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                </section>
            }
            else
            {
                QuestDetail detail = Model.SelectedQuest;
                QuestSummary quest = detail.Quest;
                bool hasBlockingRelationships = detail.Relations.TotalCount > 0 || detail.ChainLinks.Any(link => link.IsIncoming);
                string questTitle = string.IsNullOrWhiteSpace(quest.Title) ? "Unnamed quest" : quest.Title;

                <section class="panel viewer-panel-flush viewer-workbench">
                    <header class="viewer-record-header">
                        <span class="viewer-record-icon"><i class="bi bi-journal-text"></i></span>
                        <div>
                            <span class="eyebrow">Selected quest</span>
                            <h2>@questTitle</h2>
                            <p>Entry @quest.Entry · @quest.TotalRelationCount.ToString("N0") world relationship@(quest.TotalRelationCount == 1 ? string.Empty : "s") · @detail.ChainLinks.Count chain link@(detail.ChainLinks.Count == 1 ? string.Empty : "s")</p>
                        </div>
                        <div class="viewer-record-actions">
                            <a class="btn btn-outline-secondary btn-sm"
                               asp-action="Quests"
                               asp-route-database="@Model.Database"
                               asp-route-search="@Model.Search"
                               asp-route-show="true"
                               asp-route-page="@Model.Quests.Page"
                               asp-route-pageSize="@Model.Quests.PageSize">
                                <i class="bi bi-arrow-left"></i> Results
                            </a>
                            @if (Model.CanAddRelations)
                            {
                                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#questAddRelationModal"><i class="bi bi-plus-lg"></i> Add world relationship</button>
                            }
                            @if (Model.CanEditQuests)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#questEditModal"><i class="bi bi-pencil"></i> Edit quest</button>
                            }
                            @if (Model.CanDeleteQuests)
                            {
                                <button type="button"
                                        class="btn btn-outline-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#questDeleteModal"
                                        disabled="@hasBlockingRelationships"
                                        title="@(hasBlockingRelationships ? "Remove world relationships and incoming chain links before deleting this quest." : "Delete quest")">
                                    <i class="bi bi-trash"></i> Delete quest
                                </button>
                            }

                            <partial name="_ViewerPendingRecordActions" />
                        </div>
                    </header>

                    <div class="viewer-detail-metrics">
                        <div>
                            <small>Quest level</small>
                            <strong>@(quest.QuestLevel?.ToString(CultureInfo.InvariantCulture) ?? "—")</strong>
                            <span>minimum @(quest.MinLevel?.ToString(CultureInfo.InvariantCulture) ?? "—")</span>
                        </div>
                        <div>
                            <small>World starters</small>
                            <strong>@quest.StarterCount.ToString("N0")</strong>
                            <span>@quest.CreatureStarterCount creature / @quest.GameObjectStarterCount GameObject</span>
                        </div>
                        <div>
                            <small>World enders</small>
                            <strong>@quest.EnderCount.ToString("N0")</strong>
                            <span>@quest.CreatureEnderCount creature / @quest.GameObjectEnderCount GameObject</span>
                        </div>
                        <div>
                            <small>Chain links</small>
                            <strong>@detail.ChainLinks.Count.ToString("N0")</strong>
                            <span>direct, incoming, and group relationships</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(detail.Details) || !string.IsNullOrWhiteSpace(detail.Objectives))
                    {
                        <section class="viewer-record-section" aria-labelledby="questTextHeading">
                            <header class="viewer-record-section-header">
                                <div>
                                    <span class="eyebrow">Quest content</span>
                                    <h3 id="questTextHeading">Details &amp; objectives</h3>
                                    <p>Quest text is shown with the same shared workbench table used throughout the other viewers.</p>
                                </div>
                                <span class="badge rounded-pill">@((string.IsNullOrWhiteSpace(detail.Details) ? 0 : 1) + (string.IsNullOrWhiteSpace(detail.Objectives) ? 0 : 1)) field@(((string.IsNullOrWhiteSpace(detail.Details) ? 0 : 1) + (string.IsNullOrWhiteSpace(detail.Objectives) ? 0 : 1)) == 1 ? string.Empty : "s")</span>
                            </header>
                            <div class="viewer-record-table-wrap">
                                <table class="table studio-table viewer-record-table viewer-workbench-table mb-0">
                                    <colgroup><col class="viewer-table-col-label" /><col class="viewer-table-col-content" /></colgroup>
                                    <thead>
                                        <tr>
                                            <th>Field</th>
                                            <th>Content</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!string.IsNullOrWhiteSpace(detail.Details))
                                        {
                                            <tr>
                                                <td>
                                                    <strong>Details</strong>
                                                </td>
                                                <td>@detail.Details</td>
                                            </tr>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(detail.Objectives))
                                        {
                                            <tr>
                                                <td>
                                                    <strong>Objectives</strong>
                                                </td>
                                                <td>@detail.Objectives</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    }

                    <section class="viewer-record-section" aria-labelledby="questChainHeading">
                        <header class="viewer-record-section-header">
                            <div>
                                <span class="eyebrow">Quest relationships</span>
                                <h3 id="questChainHeading">Quest chain</h3>
                                <p>Direct chain fields, incoming references, and exclusive-group peers are resolved back to quest_template.</p>
                            </div>
                            <span class="badge rounded-pill">@detail.ChainLinks.Count.ToString("N0") link@(detail.ChainLinks.Count == 1 ? string.Empty : "s")</span>
                        </header>

                        @if (detail.ChainLinks.Count == 0)
                        {
                            <div class="viewer-record-empty">
                                <i class="bi bi-signpost"></i>
                                <strong>No chain relationships detected</strong>
                                <p>This quest has no direct or incoming references in the supported quest_template chain fields.</p>
                            </div>
                        }
                        else
                        {
                            <div class="viewer-record-table-wrap">
                                <table class="table studio-table viewer-record-table viewer-workbench-table mb-0">
                                    <colgroup>
                                        <col class="viewer-table-col-kind" />
                                        <col class="viewer-table-col-entity" />
                                        <col class="viewer-table-col-reference" />
                                        <col class="viewer-table-col-actions" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>Relationship</th>
                                            <th>Quest</th>
                                            <th class="viewer-table-center">Stored reference</th>
                                            <th class="actions-column viewer-action-column viewer-table-center">Open</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (QuestChainLink link in detail.ChainLinks)
                                    {
                                        string linkedTitle = link.Exists
                                            ? (string.IsNullOrWhiteSpace(link.Title) ? "Quest " + link.Entry : link.Title)
                                            : "Missing quest " + link.Entry;
                                        <tr>
                                            <td>
                                                <div class="viewer-member-type">
                                                    <span><i class="bi @(link.IsIncoming ? "bi-box-arrow-in-left" : "bi-signpost-split")"></i></span>
                                                    <div>
                                                        <strong>@link.RelationLabel</strong>
                                                        <code>@link.RelationCode</code>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="viewer-resolved-entity @(link.Exists ? "is-resolved" : "is-unresolved")">
                                                    <strong>@linkedTitle</strong>
                                                    <small>Entry @link.Entry</small>
                                                    <span>@(link.Exists ? "Resolved quest" : "Missing quest")</span>
                                                </div>
                                            </td>
                                            <td class="viewer-table-center">
                                                <code>@link.RelationCode = @link.RawValue</code>
                                            </td>
                                            <td class="actions-column viewer-action-column viewer-table-center">
                                                @if (link.Exists)
                                                {
                                                    <a class="icon-button"
                                                       asp-action="Quests"
                                                       asp-route-database="@Model.Database"
                                                       asp-route-search="@Model.Search"
                                                       asp-route-show="true"
                                                       asp-route-entry="@link.Entry"
                                                       asp-route-page="@Model.Quests.Page"
                                                       asp-route-pageSize="@Model.Quests.PageSize"
                                                       title="Open quest @link.Entry"
                                                       aria-label="Open quest @link.Entry">
                                                        <i class="bi bi-chevron-right"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>

                    <section class="viewer-record-section" aria-labelledby="questRelationsHeading">
                        <header class="viewer-record-section-header">
                            <div>
                                <span class="eyebrow">World links</span>
                                <h3 id="questRelationsHeading">Creature &amp; GameObject relationships</h3>
                                <p>Quest starters and enders are shown together while preserving the table and role used by the database.</p>
                            </div>
                            <span class="badge rounded-pill">@detail.Relations.TotalCount.ToString("N0") relationship@(detail.Relations.TotalCount == 1 ? string.Empty : "s")</span>
                        </header>

                        @if (detail.Relations.TotalCount == 0)
                        {
                            <div class="viewer-record-empty">
                                <i class="bi bi-link-45deg"></i>
                                <strong>No creature or GameObject relationships</strong>
                                <p>No supported quest starter/ender rows point at this quest.</p>
                            </div>
                        }
                        else
                        {
                            <div class="viewer-record-table-wrap">
                                <table class="table studio-table viewer-record-table viewer-workbench-table mb-0">
                                    <colgroup>
                                        <col class="viewer-table-col-kind" />
                                        <col class="viewer-table-col-entity" />
                                        <col class="viewer-table-col-role" />
                                        <col class="viewer-table-col-storage" />
                                        <col class="viewer-table-col-actions" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>Type</th>
                                            <th>Resolved entity</th>
                                            <th class="viewer-table-center">Role</th>
                                            <th class="viewer-table-center">Storage</th>
                                            <th class="actions-column viewer-action-column viewer-table-center">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (QuestRelationRow relation in detail.Relations.Items)
                                    {
                                        bool startsQuest = relation.RoleLabel.StartsWith("Starts", StringComparison.Ordinal);
                                        <tr>
                                            <td>
                                                <div class="viewer-member-type">
                                                    <span><i class="bi @(relation.EntityType == "Creature" ? "bi-person-standing" : "bi-box")"></i></span>
                                                    <div>
                                                        <strong>@relation.EntityType</strong>
                                                        <code>@relation.Kind</code>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="viewer-resolved-entity @(relation.IsResolved ? "is-resolved" : "is-unresolved")">
                                                    <strong>@(relation.IsResolved ? relation.EntityName : "Unresolved entry")</strong>
                                                    <small>Entry @relation.EntityEntry</small>
                                                    <span>@(relation.IsResolved ? "Resolved template" : "Missing template")</span>
                                                </div>
                                            </td>
                                            <td class="viewer-table-center">
                                                <div class="viewer-composition-chips">
                                                    <span><i class="bi @(startsQuest ? "bi-play-circle" : "bi-check-circle")"></i> @relation.RoleLabel</span>
                                                </div>
                                            </td>
                                            <td class="viewer-table-center">
                                                <code>@relation.StorageTable</code>
                                            </td>
                                            <td class="actions-column viewer-action-column viewer-table-center">
                                                <div class="row-actions row-actions-compact">
                                                    @if (Model.CanEditRelations)
                                                    {
                                                        <button type="button"
                                                                class="icon-button"
                                                                title="Edit relationship"
                                                                aria-label="Edit relationship"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#questEditRelationModal"
                                                                data-quest-edit-relation
                                                                data-kind="@relation.Kind"
                                                                data-entry="@relation.EntityEntry"
                                                                data-name="@(relation.IsResolved ? relation.EntityName : relation.EntityType + " " + relation.EntityEntry)">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                    }
                                                    @if (Model.CanRemoveRelations)
                                                    {
                                                        <button type="button"
                                                                class="icon-button danger"
                                                                title="Remove relationship"
                                                                aria-label="Remove relationship"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#questRemoveRelationModal"
                                                                data-quest-remove-relation
                                                                data-kind="@relation.Kind"
                                                                data-entry="@relation.EntityEntry"
                                                                data-name="@(relation.IsResolved ? relation.EntityName : relation.EntityType + " " + relation.EntityEntry)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    }

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>

                            <footer class="viewer-record-footer">
                                <div class="viewer-record-pagination-wrap">
                                    <div class="pagination-status">
                                        <strong>Page @detail.Relations.Page</strong>
                                        <span>of @Math.Max(detail.Relations.TotalPages, 1) · @detail.Relations.TotalCount.ToString("N0") relationships</span>
                                    </div>
                                    @if (detail.Relations.TotalPages > 1)
                                    {
                                        <nav class="world-pagination viewer-record-pagination" aria-label="Quest relationship pages">
                                            <ul class="pagination mb-0">
                                                <li class="page-item pagination-direction @(detail.Relations.Page == 1 ? "disabled" : string.Empty)">
                                                    <a class="page-link"
                                                       asp-action="Quests"
                                                       asp-route-database="@Model.Database"
                                                       asp-route-search="@Model.Search"
                                                       asp-route-show="true"
                                                       asp-route-entry="@quest.Entry"
                                                       asp-route-page="@Model.Quests.Page"
                                                       asp-route-pageSize="@Model.Quests.PageSize"
                                                       asp-route-relationPage="@(detail.Relations.Page - 1)"
                                                       asp-route-relationPageSize="@detail.Relations.PageSize">
                                                        <i class="bi bi-chevron-left"></i><span>Previous</span>
                                                    </a>
                                                </li>
                                                @for (int pageNumber = relationFirstPage; pageNumber <= relationLastPage; pageNumber++)
                                                {
                                                    <li class="page-item @(pageNumber == detail.Relations.Page ? "active" : string.Empty)">
                                                        <a class="page-link"
                                                           asp-action="Quests"
                                                           asp-route-database="@Model.Database"
                                                           asp-route-search="@Model.Search"
                                                           asp-route-show="true"
                                                           asp-route-entry="@quest.Entry"
                                                           asp-route-page="@Model.Quests.Page"
                                                           asp-route-pageSize="@Model.Quests.PageSize"
                                                           asp-route-relationPage="@pageNumber"
                                                           asp-route-relationPageSize="@detail.Relations.PageSize">@pageNumber</a>
                                                    </li>
                                                }
                                                <li class="page-item pagination-direction @(detail.Relations.Page == detail.Relations.TotalPages ? "disabled" : string.Empty)">
                                                    <a class="page-link"
                                                       asp-action="Quests"
                                                       asp-route-database="@Model.Database"
                                                       asp-route-search="@Model.Search"
                                                       asp-route-show="true"
                                                       asp-route-entry="@quest.Entry"
                                                       asp-route-page="@Model.Quests.Page"
                                                       asp-route-pageSize="@Model.Quests.PageSize"
                                                       asp-route-relationPage="@(detail.Relations.Page + 1)"
                                                       asp-route-relationPageSize="@detail.Relations.PageSize">
                                                        <span>Next</span><i class="bi bi-chevron-right"></i>
                                                    </a>
                                                </li>
                                            </ul>
                                        </nav>
                                    }
                                </div>

                                <form method="get" asp-action="Quests" class="viewer-record-page-size">
                                    <input type="hidden" name="database" value="@Model.Database" />
                                    <input type="hidden" name="search" value="@Model.Search" />
                                    <input type="hidden" name="show" value="true" />
                                    <input type="hidden" name="entry" value="@quest.Entry" />
                                    <input type="hidden" name="page" value="@Model.Quests.Page" />
                                    <input type="hidden" name="pageSize" value="@Model.Quests.PageSize" />
                                    <input type="hidden" name="relationPage" value="1" />
                                    <label class="world-filter-select">
                                        <span>Rows per page</span>
                                        <select name="relationPageSize" class="form-select" onchange="this.form.submit()">
                                            @foreach (int size in pageSizes)
                                            {
                                                if (detail.Relations.PageSize == size) { <option value="@size" selected>@size</option> }
                                                else { <option value="@size">@size</option> }
                                            }
                                        </select>
                                    </label>
                                </form>
                            </footer>
                        }
                    </section>
                </section>
            }
        </main>
    </div>
</div>

@if (Model.IsAvailable && Model.CanAddRelations && Model.EditorCapabilities.RelationKinds.Count > 0)
