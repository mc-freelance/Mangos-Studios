    @if (Model.CanDeleteVendorItems)
    {
        <div class="modal fade npc-vendor-editor-modal" id="npcVendorDeleteModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-md modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" asp-action="NpcVendorDeleteItem" data-npc-vendor-delete-form>
