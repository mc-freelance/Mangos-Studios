                                        <span>Item</span>
                                        <div class="npc-vendor-item-picker" data-npc-vendor-item-picker>
                                            <input type="hidden" name="Items[0].ItemId" data-field="ItemId" data-npc-vendor-item-id />
                                            <button
                                                type="button"
                                                class="form-select npc-vendor-item-picker-toggle"
                                                data-npc-vendor-item-picker-toggle
                                                aria-haspopup="listbox"
                                                aria-expanded="false">
                                                <span data-npc-vendor-item-picker-label>Select an item...</span>
                                            </button>
                                        </div>
                                    </label>
                                    @if (caps.HasSlot)
                                    {
                                        <label>
                                            <span>Slot</span>
                                            <input class="form-control" type="number" min="0" name="Items[0].Slot" value="0" data-field="Slot" />
                                        </label>
                                    }
                                    @if (caps.HasMaxCount)
                                    {
                                        <label>
                                            <span>Max stock</span>
                                            <input class="form-control" type="number" min="0" name="Items[0].MaxCount" value="0" data-field="MaxCount" />
                                        </label>
                                    }
                                    @if (caps.HasIncrementTime)
                                    {
                                        <label>
                                            <span>Restock (sec)</span>
                                            <input class="form-control" type="number" min="0" name="Items[0].IncrementTime" value="0" data-field="IncrementTime" />
                                        </label>
                                    }
                                    @if (caps.HasExtendedCost)
                                    {
                                        <label>
                                            <span>Extended cost</span>
                                            <input class="form-control" type="number" min="0" name="Items[0].ExtendedCost" value="0" data-field="ExtendedCost" />
                                        </label>
                                    }
                                    @if (caps.HasConditionId)
                                    {
                                        <label>
                                            <span>Condition</span>
                                            <input class="form-control" type="number" min="0" name="Items[0].ConditionId" value="0" data-field="ConditionId" />
                                        </label>
                                    }
                                    <button
                                        type="button"
                                        class="btn btn-outline-danger btn-sm npc-vendor-batch-remove"
                                        data-npc-vendor-remove-row
                                        disabled
                                        title="Remove row"
                                        aria-label="Remove row"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>


                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add selected items</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (Model.CanEditVendorItems)
