                        <input type="hidden" name="Original.ItemId" data-loot-edit-original-item /><input type="hidden" name="Original.Chance" data-loot-edit-original-chance /><input type="hidden" name="Original.GroupId" data-loot-edit-original-group /><input type="hidden" name="Original.RowKind" data-loot-edit-original-kind /><input type="hidden" name="Original.MinCount" data-loot-edit-original-min /><input type="hidden" name="Original.ReferenceEntry" data-loot-edit-original-reference /><input type="hidden" name="Original.MaxCount" data-loot-edit-original-max /><input type="hidden" name="Original.ConditionId" data-loot-edit-original-condition />
                        <div class="viewer-edit-member-context viewer-editor-wide">
                            <span><i class="bi bi-gift"></i></span>
                            <div>
                                <small>Current loot row</small>
                                <strong data-loot-edit-name>Loot row</strong>
                                <code>@selectedTemplateForEditor.TableName · entry @selectedTemplateForEditor.Entry</code>
                            </div>
                        </div>
                        @if (selectedEditor.SupportsReferences)
                        {
                            <label>
                                <span>Row type</span>
                                <select class="form-select" name="Replacement.RowKind" data-loot-edit-kind><option value="item">Direct item</option><option value="reference">Reference loot</option></select>
                            </label>
                        }
                        else
                        {
                            <input type="hidden" name="Replacement.RowKind" value="item" />
                        }
                        <label data-loot-edit-item-picker-field>
                            <span>Item</span>
                            <div class="npc-vendor-item-picker"
                                 data-world-lookup-picker
                                 data-world-lookup-required="true"
                                 data-world-lookup-url="@itemLookupUrl"
                                 data-world-lookup-database="@Model.Database"
                                 data-world-lookup-singular="Item"
                                 data-world-lookup-plural="items"
                                 data-world-lookup-placeholder="Select an item..."
                                 data-world-lookup-search-placeholder="Search item name or ID">
                                <input type="hidden" name="Replacement.ItemId" data-loot-edit-item data-world-lookup-value />
                                <button
                                    type="button"
                                    class="form-select npc-vendor-item-picker-toggle is-placeholder"
                                    data-world-lookup-toggle
                                    aria-haspopup="listbox"
                                    aria-expanded="false">
                                    <span data-world-lookup-label>Select an item...</span>
                                </button>
                            </div>
                        </label>
                        <label data-loot-edit-row-key-field hidden>
                            <span>Reference row key</span>
                            <input class="form-control" type="number" name="Replacement.ItemId" min="0" required data-loot-edit-row-key disabled />
                        </label>
                        @if (selectedEditor.HasChance)
                        {
                            <label>
                                <span>Chance (%)</span>
                                <input class="form-control" type="number" name="Replacement.Chance" min="-100" max="100" step="0.001" data-loot-edit-chance />
                            </label>
                        }
                        @if (selectedEditor.HasGroupId)
                        {
                            <label>
                                <span>Group ID</span>
                                <input class="form-control" type="number" name="Replacement.GroupId" min="0" data-loot-edit-group />
                            </label>
                        }
                        @if (selectedEditor.HasMinCountOrReference)
                        {
                            <label data-loot-edit-min-field>
                                <span>Minimum count</span>
                                <input class="form-control" type="number" name="Replacement.MinCount" min="1" required data-loot-edit-min />
                            </label>
                        }
                        @if (selectedEditor.SupportsReferences)
                        {
                            <label data-loot-edit-reference-field hidden>
                                <span>Reference loot entry</span>
                                <input class="form-control" type="number" name="Replacement.ReferenceEntry" min="1" required data-loot-edit-reference />
                            </label>
                        }
                        @if (selectedEditor.HasMaxCount)
                        {
                            <label>
                                <span data-loot-edit-max-label>Maximum count</span>
                                <input class="form-control" type="number" name="Replacement.MaxCount" min="1" data-loot-edit-max />
                            </label>
                        }
                        @if (selectedEditor.HasConditionId)
                        {
                            <label>
                                <span>Condition ID</span>
                                <input class="form-control" type="number" name="Replacement.ConditionId" min="0" data-loot-edit-condition />
                            </label>
                        }
                        <div class="viewer-editor-help viewer-editor-wide">
                            <i class="bi bi-info-circle"></i>
                            <span data-loot-edit-help>The loot table and definition entry stay fixed. Editing changes the existing row directly and records a reversible SQL change.</span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save loot row changes</button>
                    </div>
                </form>
            </div>
            </div>
        </div>
    }

    @if (Model.CanRemoveRows)
    {
        <div class="modal fade viewer-editor-modal loot-editor-modal" id="lootDeleteRowModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                <form method="post" asp-action="LootDeleteRow" data-loot-delete-form>
                    <div class="modal-header">
                        <div>
                            <span class="eyebrow">Loot row</span>
                            <h2 class="modal-title fs-5">Remove loot row?</h2>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="Database" value="@Model.Database" /><input type="hidden" name="Search" value="@Model.Search" /><input type="hidden" name="TableFilter" value="@Model.TableFilter" /><input type="hidden" name="ReturnUrl" value="@selectedReturnUrl" /><input type="hidden" name="LootTable" value="@selectedTemplateForEditor.TableName" /><input type="hidden" name="Entry" value="@selectedTemplateForEditor.Entry" /><input type="hidden" name="Page" value="@Model.Templates.Page" /><input type="hidden" name="PageSize" value="@Model.Templates.PageSize" /><input type="hidden" name="RowPage" value="@Model.SelectedTemplate.Rows.Page" /><input type="hidden" name="RowPageSize" value="@Model.SelectedTemplate.Rows.PageSize" />
                        <input type="hidden" name="Original.ItemId" data-loot-delete-item /><input type="hidden" name="Original.Chance" data-loot-delete-chance /><input type="hidden" name="Original.GroupId" data-loot-delete-group /><input type="hidden" name="Original.RowKind" data-loot-delete-kind /><input type="hidden" name="Original.MinCount" data-loot-delete-min /><input type="hidden" name="Original.ReferenceEntry" data-loot-delete-reference /><input type="hidden" name="Original.MaxCount" data-loot-delete-max /><input type="hidden" name="Original.ConditionId" data-loot-delete-condition />
                        <div class="viewer-remove-confirmation">
                            <span><i class="bi bi-trash"></i></span>
                            <div>
                                <small>Loot row to remove</small>
                                <strong data-loot-delete-name>Selected loot row</strong>
                                <p>This removes only the selected row from @selectedTemplateForEditor.TableName. If it is the final row, the loot definition will disappear from the directory.</p>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Remove loot row</button>
                    </div>
                </form>
            </div>
            </div>
        </div>
    }
}

@section Scripts {
<script src="~/js/world-lookup-picker.js" asp-append-version="true"></script>
<script>
(() => {
    const root = document.querySelector('[data-loot-viewer]');
    if (!root)
    {
        return;
    }

    const setFieldVisible = (field, visible) => {
        if (!field)
        {
            return;
        }
        field.hidden = !visible;
        field.querySelectorAll('input, select, textarea').forEach(control => { control.disabled = !visible; });
    };

    const addTable = document.querySelector('[data-loot-add-table]');
    const addKind = document.querySelector('[data-loot-add-kind]');
    const addEntry = document.querySelector('[data-loot-add-entry]');
    const addKindField = document.querySelector('[data-loot-row-kind-field]');
    const addItemPickerField = document.querySelector('[data-loot-item-picker-field]');
    const addRowKeyField = document.querySelector('[data-loot-row-key-field]');
    const addChanceField = document.querySelector('[data-loot-chance-field]');
    const addGroupField = document.querySelector('[data-loot-group-field]');
    const addMinField = document.querySelector('[data-loot-min-field]');
    const addReferenceField = document.querySelector('[data-loot-reference-field]');
    const addMaxField = document.querySelector('[data-loot-max-field]');
    const addConditionField = document.querySelector('[data-loot-condition-field]');
    const addMaxLabel = document.querySelector('[data-loot-max-label]');
    const addHelp = document.querySelector('[data-loot-row-help]');

    const syncAddFields = () => {
        const option = addTable?.selectedOptions?.[0];
        if (!option)
        {
            return;
        }
        const supportsReference = option.dataset.supportsReference === 'true';
        const isReference = supportsReference && addKind?.value === 'reference';
        setFieldVisible(addKindField, supportsReference);
        setFieldVisible(addItemPickerField, !isReference);
        setFieldVisible(addRowKeyField, isReference);
        setFieldVisible(addChanceField, option.dataset.hasChance === 'true');
        setFieldVisible(addGroupField, option.dataset.hasGroup === 'true');
        setFieldVisible(addMinField, option.dataset.hasMin === 'true' && !isReference);
        setFieldVisible(addReferenceField, supportsReference && isReference);
        setFieldVisible(addMaxField, option.dataset.hasMax === 'true');
        setFieldVisible(addConditionField, option.dataset.hasCondition === 'true');
        if (addMaxLabel)
        {
            addMaxLabel.textContent = isReference ? 'Reference repetitions' : 'Maximum count';
        }
        if (addHelp) addHelp.textContent = isReference
            ? 'Reference rows point to reference_loot_template through the reference entry. The row key still must be unique within this loot definition. Entering a new loot entry creates a new definition with this as its first row.'
            : 'Direct rows resolve the item entry through item_template. Entering a new loot entry creates a new definition with this as its first row. Negative MaNGOS quest chances are supported.';
    };
    addTable?.addEventListener('change', syncAddFields);
    addKind?.addEventListener('change', syncAddFields);
    document.querySelectorAll('[data-loot-add-open]').forEach(button => {
        button.addEventListener('click', () => {
            if (addTable && button.dataset.table)
            {
                addTable.value = button.dataset.table;
            }
            if (addEntry)
            {
                addEntry.value = button.dataset.entry || '';
            }
            syncAddFields();
        });
    });
    syncAddFields();

    const editModalElement = document.getElementById('lootEditRowModal');
    const editModal = editModalElement && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(editModalElement) : null;
    const syncEditKind = () => {
        const kind = document.querySelector('[data-loot-edit-kind]');
        const isReference = kind?.value === 'reference';
        setFieldVisible(document.querySelector('[data-loot-edit-item-picker-field]'), !isReference);
        setFieldVisible(document.querySelector('[data-loot-edit-row-key-field]'), isReference);
        setFieldVisible(document.querySelector('[data-loot-edit-min-field]'), !isReference);
        setFieldVisible(document.querySelector('[data-loot-edit-reference-field]'), isReference);
        const maxLabel = document.querySelector('[data-loot-edit-max-label]');
        const help = document.querySelector('[data-loot-edit-help]');
        if (maxLabel)
        {
            maxLabel.textContent = isReference ? 'Reference repetitions' : 'Maximum count';
        }
        if (help) help.textContent = isReference
            ? 'This row resolves through reference_loot_template. The row key remains part of the loot table primary key even though it is not the referenced loot entry.'
            : 'The loot table and definition entry stay fixed. Editing changes this existing row directly and records a reversible SQL change.';
    };
    document.querySelector('[data-loot-edit-kind]')?.addEventListener('change', syncEditKind);

    document.querySelectorAll('[data-loot-edit-open]').forEach(button => {
        button.addEventListener('click', () => {
            const value = key => button.dataset[key] || '';
            const assign = (selector, v) =>
            {
                const el = document.querySelector(selector);
                if (el)
                {
                    el.value = v;
                }
            };
            const originalKind = value('kind') || 'item';
            assign('[data-loot-edit-original-item]', value('item'));
            assign('[data-loot-edit-original-chance]', value('chance'));
            assign('[data-loot-edit-original-group]', value('group'));
            assign('[data-loot-edit-original-kind]', originalKind);
            assign('[data-loot-edit-original-min]', value('min'));
            assign('[data-loot-edit-original-reference]', value('reference'));
            assign('[data-loot-edit-original-max]', value('max'));
            assign('[data-loot-edit-original-condition]', value('condition'));
            const itemPicker = document.querySelector('[data-loot-edit-item-picker-field] [data-world-lookup-picker]');
            if (originalKind === 'reference')
            {
                assign('[data-loot-edit-row-key]', value('item'));
                window.WorldLookupPicker?.reset(itemPicker);
            }
            else
            {
                window.WorldLookupPicker?.setValue(itemPicker, value('item'), button.dataset.itemName || value('name') || 'Item');
                assign('[data-loot-edit-row-key]', '');
            }
            assign('[data-loot-edit-chance]', value('chance'));
            assign('[data-loot-edit-group]', value('group'));
            assign('[data-loot-edit-min]', value('min'));
            assign('[data-loot-edit-reference]', value('reference'));
            assign('[data-loot-edit-max]', value('max'));
            assign('[data-loot-edit-condition]', value('condition'));
            assign('[data-loot-edit-kind]', originalKind);
            const name = document.querySelector('[data-loot-edit-name]'); if (name) name.textContent = value('name') || 'Loot row';
            syncEditKind();
            editModal?.show();
        });
    });

    const deleteModalElement = document.getElementById('lootDeleteRowModal');
    const deleteModal = deleteModalElement && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(deleteModalElement) : null;
    document.querySelectorAll('[data-loot-delete-open]').forEach(button => {
        button.addEventListener('click', () => {
            const value = key => button.dataset[key] || '';
            const assign = (selector, v) =>
            {
                const el = document.querySelector(selector);
                if (el)
                {
                    el.value = v;
                }
            };
            assign('[data-loot-delete-item]', value('item'));
            assign('[data-loot-delete-chance]', value('chance'));
            assign('[data-loot-delete-group]', value('group'));
            assign('[data-loot-delete-kind]', value('kind') || 'item');
            assign('[data-loot-delete-min]', value('min'));
            assign('[data-loot-delete-reference]', value('reference'));
            assign('[data-loot-delete-max]', value('max'));
            assign('[data-loot-delete-condition]', value('condition'));
            const name = document.querySelector('[data-loot-delete-name]'); if (name) name.textContent = value('name') || 'Selected loot row';
            deleteModal?.show();
        });
    });
})();
</script>
}
