@if (Model.SelectedMenu != null && Model.CanDeleteMenuRows)
{
    <div class="modal fade viewer-editor-modal" id="gossipDeleteTextModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-action="GossipDeleteMenuRow">
                    <div class="modal-header">
                        <div>
                            <span class="eyebrow">Remove text row</span>
                            <h5 class="modal-title">Remove NPC text link?</h5>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="Database" value="@Model.Database" /><input type="hidden" name="Search" value="@Model.Search" /><input type="hidden" name="ReturnUrl" value="@returnUrl" /><input type="hidden" name="Entry" value="@Model.SelectedMenu.Menu.Entry" /><input type="hidden" name="Page" value="@directoryPage" /><input type="hidden" name="PageSize" value="@directoryPageSize" /><input type="hidden" name="TextPage" value="@Model.SelectedMenu.TextRows.Page" /><input type="hidden" name="TextPageSize" value="@Model.SelectedMenu.TextRows.PageSize" /><input type="hidden" name="OptionPage" value="@Model.SelectedMenu.Options.Page" /><input type="hidden" name="OptionPageSize" value="@Model.SelectedMenu.Options.PageSize" /><input type="hidden" name="Original.TextId" data-delete-text /><input type="hidden" name="Original.ScriptId" data-delete-script /><input type="hidden" name="Original.ConditionId" data-delete-condition />
                        <p class="mb-0">This removes text ID <strong data-delete-text-label></strong> from menu <strong>@Model.SelectedMenu.Menu.Entry</strong>. Other text rows and options are not removed.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Remove text row</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.SelectedMenu != null && Model.CanAddOptions)
{
    <div class="modal fade viewer-editor-modal gossip-option-modal" id="gossipAddOptionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-action="GossipAddOption">
                    <div class="modal-header">
                        <div>
                            <span class="eyebrow">Gossip menu @Model.SelectedMenu.Menu.Entry</span>
                            <h5 class="modal-title">Add menu option</h5>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="Database" value="@Model.Database" /><input type="hidden" name="Search" value="@Model.Search" /><input type="hidden" name="ReturnUrl" value="@returnUrl" /><input type="hidden" name="Entry" value="@Model.SelectedMenu.Menu.Entry" /><input type="hidden" name="Page" value="@directoryPage" /><input type="hidden" name="PageSize" value="@directoryPageSize" /><input type="hidden" name="TextPage" value="@Model.SelectedMenu.TextRows.Page" /><input type="hidden" name="TextPageSize" value="@Model.SelectedMenu.TextRows.PageSize" /><input type="hidden" name="OptionPage" value="@Model.SelectedMenu.Options.Page" /><input type="hidden" name="OptionPageSize" value="@Model.SelectedMenu.Options.PageSize" />@await Html.PartialAsync("_GossipOptionFields", new GossipOptionFieldsViewModel { Prefix = "Option", Capabilities = Model.EditorCapabilities })</div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add option</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.SelectedMenu != null && Model.CanEditOptions)
{
    <div class="modal fade viewer-editor-modal gossip-option-modal" id="gossipEditOptionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-action="GossipEditOption">
                    <div class="modal-header">
                        <div>
                            <span class="eyebrow">Gossip menu @Model.SelectedMenu.Menu.Entry</span>
                            <h5 class="modal-title">Edit menu option</h5>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="Database" value="@Model.Database" /><input type="hidden" name="Search" value="@Model.Search" /><input type="hidden" name="ReturnUrl" value="@returnUrl" /><input type="hidden" name="Entry" value="@Model.SelectedMenu.Menu.Entry" /><input type="hidden" name="Page" value="@directoryPage" /><input type="hidden" name="PageSize" value="@directoryPageSize" /><input type="hidden" name="TextPage" value="@Model.SelectedMenu.TextRows.Page" /><input type="hidden" name="TextPageSize" value="@Model.SelectedMenu.TextRows.PageSize" /><input type="hidden" name="OptionPage" value="@Model.SelectedMenu.Options.Page" /><input type="hidden" name="OptionPageSize" value="@Model.SelectedMenu.Options.PageSize" />
                        <div data-gossip-original-option></div>@await Html.PartialAsync("_GossipOptionFields", new GossipOptionFieldsViewModel { Prefix = "Replacement", Capabilities = Model.EditorCapabilities })</div>
