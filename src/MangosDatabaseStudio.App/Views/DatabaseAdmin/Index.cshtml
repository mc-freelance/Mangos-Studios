@* Present the DatabaseAdmin workspace and its available actions. *@

@model DatabaseAdminIndexViewModel
@{
    ViewData["Title"] = "Databases";
    ViewData["Section"] = "Database Administration";
}
<div class="page-actions">
    <div>
        <span class="eyebrow">Database server</span>
        <p class="page-lead">Inspect the user databases visible to the active MySQL or MariaDB account. Internal server schemas stay hidden.</p>
    </div>
</div>
<div class="data-table-wrap">
    <table class="studio-table responsive-table database-list-table">
        <thead>
            <tr>
                <th>Database</th>
                <th>Character set</th>
                <th>Collation</th>
                <th class="actions-column">Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Databases.Count == 0)
        {
            <tr>
                <td colspan="4" class="empty-cell">No user databases are visible to this connection.</td>
            </tr>
        }
        @foreach (var database in Model.Databases)
        {
            <tr>
                <td data-label="Database">
                    <strong>@database.Name</strong>
                </td>
                <td data-label="Character set">@database.CharacterSet</td>
                <td data-label="Collation">@database.Collation</td>
                <td data-label="Actions" class="actions-column">
                    <div class="row-actions">
                        <a class="btn btn-outline-primary btn-sm" asp-action="Tables" asp-route-database="@database.Name">
                            <i class="bi bi-table" aria-hidden="true"></i>
                            <span>Open tables</span>
                        </a>
                        @if (User.HasPermission(AppPermissions.SqlConsoleView))
                        {
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="SqlConsole" asp-action="Index" asp-route-database="@database.Name">
                                <i class="bi bi-terminal" aria-hidden="true"></i>
                                <span>SQL</span>
                            </a>
                        }
                        @if (User.HasPermission(AppPermissions.SqlExportView))
                        {
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="Export" asp-action="Index" asp-route-database="@database.Name">
                                <i class="bi bi-download" aria-hidden="true"></i>
                                <span>Export</span>
                            </a>
                        }
                        @if (User.HasPermission(AppPermissions.DatabaseUpdatesView))
                        {
                            <a class="btn btn-outline-secondary btn-sm" asp-controller="DatabaseUpdates" asp-action="Index" asp-route-database="@database.Name">
                                <i class="bi bi-database-up" aria-hidden="true"></i>
                                <span>Updates</span>
                            </a>
                        }
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
