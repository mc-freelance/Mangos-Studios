@* Present and validate the Roles record editor. *@

@model RolePermissionsEditViewModel
@{
    ViewData["Title"] = Model.DisplayName + " Permissions";
    ViewData["Section"] = "System / Roles & Permissions";
}
<div class="page-actions">
    <div>
        <p class="page-lead">@Model.Description</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> All roles</a>
</div>

@if (Model.IsAdministrator)
{
    <div class="alert alert-info studio-inline-alert rbac-notice">
        <i class="bi bi-info-circle-fill"></i>
        <div>
            <strong>Administrator access is protected</strong>
            <span>All permissions remain enabled for this role to prevent administrative lockout.</span>
        </div>
    </div>
}
else
{
    <div class="alert alert-secondary studio-inline-alert rbac-notice">
        <i class="bi bi-info-circle-fill"></i>
        <div>
            <strong>Permission dependencies</strong>
            <span>Required permissions are included automatically. For example, record editing also includes the access needed to browse world records.</span>
        </div>
    </div>
}

<form method="post" asp-action="Edit" class="rbac-editor">
    <input asp-for="Role" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    @foreach (PermissionGroupViewModel group in Model.Groups)
    {
        <section class="panel rbac-permission-group">
            <div class="section-heading compact">
                <div>
                    <span class="eyebrow">Permission group</span>
                    <h2>@group.Name</h2>
                </div>
                <span class="badge text-bg-light">@group.Permissions.Count</span>
            </div>
            <div class="rbac-permission-list">
                @foreach (PermissionOptionViewModel permission in group.Permissions)
                {
                    bool locked = Model.IsAdministrator || permission.AdministratorOnly;
                    <label class="rbac-permission-option @(locked ? "locked" : string.Empty)">
                        <span class="rbac-permission-check">
                            <input class="form-check-input" type="checkbox" name="Permissions" value="@permission.Name" checked="@permission.Selected" disabled="@locked" />
                            @if (locked && permission.Selected)
                            {
                                <input type="hidden" name="Permissions" value="@permission.Name" />
                            }
                        </span>
                        <span class="rbac-permission-copy">
                            <strong>@permission.DisplayName</strong>
                            <small>@permission.Description</small>
                            @if (permission.AdministratorOnly)
                            {
                                <span class="rbac-permission-meta"><i class="bi bi-lock"></i> Administrator only</span>
                            }
                            else if (permission.Dependencies.Count > 0)
                            {
                                <span class="rbac-permission-meta">Includes required access automatically</span>
                            }
                        </span>
                        <code>@permission.Name</code>
                    </label>
                }
            </div>
        </section>
    }

    <div class="form-actions sticky-actions">
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        @if (!Model.IsAdministrator)
        {
            <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i> Save permissions</button>
        }
    </div>
</form>

@if (!Model.IsAdministrator)
{
    <form asp-action="Reset" method="post" class="mt-3" data-confirm="Reset @Model.DisplayName permissions to their defaults?">
        <input type="hidden" name="role" value="@Model.Role" />
        <button class="btn btn-outline-danger" type="submit"><i class="bi bi-arrow-counterclockwise"></i> Reset to defaults</button>
    </form>
}
