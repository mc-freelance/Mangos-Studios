@* Shared presentation used by login and setup pages. *@

@{
    const string desktopHostValue = "true";
    string authShellClass = ViewData["AuthShellClass"]?.ToString() ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en"
      data-studio-theme="premium"
      data-desktop-host="@desktopHostValue"
      data-desktop-zoom="@DesktopZoomPreferences.DefaultPercent"
      data-desktop-auto-scale="true">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MaNGOS Database Studio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <script src="~/js/desktop-scaling.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes/premium.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-background"></div>
    <main class="auth-shell @authShellClass">
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/studio-dialog.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
