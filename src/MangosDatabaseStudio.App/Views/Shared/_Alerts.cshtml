@* Display status, warning, and validation feedback in the shared layout. *@

@if (TempData["Success"] is string success)
{
    <div class="alert studio-notice studio-notice-success fade show"
         role="status"
         data-studio-alert
         data-alert-level="success"
         data-auto-dismiss="5000">
        <span class="studio-notice-icon" aria-hidden="true"><i class="bi bi-check-circle-fill"></i></span>
        <div class="studio-notice-copy">
            <strong>Success</strong>
            <p>@success</p>
        </div>
        <button type="button" class="studio-notice-dismiss" data-bs-dismiss="alert" aria-label="Dismiss success message">
            <i class="bi bi-x-lg"></i>
        </button>
        <span class="studio-notice-timer" aria-hidden="true"><span></span></span>
    </div>
}
