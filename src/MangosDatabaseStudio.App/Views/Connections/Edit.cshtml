@* Present and validate the Connections record editor. *@

@model ConnectionProfileViewModel
@{
    bool isNew = Model.Id == Guid.Empty;
    ViewData["Title"] = isNew ? "Add Connection" : "Edit Connection";
    ViewData["Section"] = "System / Connections";
    string submitAction = isNew ? "Create" : "Edit";
    bool tlsDisabled = MangosDatabaseStudio.Domain.Connections.ConnectionTlsSecurity.IsTlsDisabled(Model.SslMode);
    bool verifiedTls = string.Equals(Model.SslMode, "VerifyFull", StringComparison.OrdinalIgnoreCase);
    bool caRequired = string.Equals(Model.SslMode, "VerifyFull", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.SslMode, "VerifyCA", StringComparison.OrdinalIgnoreCase);
    string tlsRiskMessage = Model.SslMode switch
    {
        "VerifyCA" => "The server hostname is not verified.",
        "Required" => "The server certificate is not verified.",
        "Preferred" => "The connection may use plaintext.",
        "Disabled" or "None" => "No TLS. Use only with trusted local servers.",
        _ => "Server identity is not fully verified."
    };
}
<div class="form-shell narrow connection-profile-editor">
    <form method="post" asp-action="@submitAction" asp-route-id="@(isNew ? (Guid?)null : Model.Id)" class="panel">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <div class="section-heading">
            <div>
                <span class="eyebrow">Server profile</span>
                <h2>@(isNew ? "Add a database connection" : "Edit database connection")</h2>
                <p class="section-copy">Use a direct MySQL or MariaDB connection for the current release.</p>
            </div>
            <i class="bi bi-hdd-network"></i>
        </div>

        <div class="connection-method-grid" aria-label="Connection method">
            <div class="connection-method-card is-selected">
                <div class="connection-method-icon">
                    <i class="bi bi-hdd-network"></i>
                </div>
                <div>
                    <strong>Direct database</strong>
                    <span>Host or IP address, port, username, and password.</span>
                </div>
                <span class="connection-method-status">Current</span>
            </div>
            <div class="connection-method-card is-disabled" aria-disabled="true">
                <div class="connection-method-icon">
                    <i class="bi bi-link-45deg"></i>
                </div>
                <div>
                    <strong>Backend service</strong>
                    <span>URI and 128-bit access hash generated by a future MaNGOS Database Studio backend.</span>
                </div>
                <span class="connection-method-status">Coming later</span>
            </div>
        </div>

        <div class="connection-editor-section" data-connection-tls-editor>
            <div class="connection-editor-section-heading">
                <div>
                    <span class="eyebrow">Direct connection</span>
                    <strong>Database credentials</strong>
                </div>
                @if (!isNew)
                {
                    <span class="read-only-pill"><i class="bi bi-pencil"></i> Editing saved profile</span>
                }
            </div>

            <div class="form-grid">
                <div class="form-group span-2">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Host" class="form-label"></label>
                    <input asp-for="Host" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Host" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Port" class="form-label"></label>
                    <input asp-for="Port" class="form-control" />
                    <span asp-validation-for="Port" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <div class="form-text">@(isNew ? "Required for a new connection." : "Leave blank to keep the currently saved password.")</div>
                </div>
                <div class="form-group">
                    <label asp-for="DefaultDatabase" class="form-label">Default world database</label>
                    <input asp-for="DefaultDatabase" class="form-control" />
                    <span asp-validation-for="DefaultDatabase" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="SslMode" class="form-label">SSL mode</label>
                    <select asp-for="SslMode" class="form-select" data-tls-mode>
                        <option value="VerifyFull">VerifyFull — certificate and hostname</option>
                        <option value="VerifyCA">VerifyCA — certificate only</option>
                        <option value="Required">Required — unverified TLS</option>
                        <option value="Preferred">Preferred — TLS optional</option>
                        <option value="Disabled">Disabled — no TLS</option>
                        <option value="None">None — no TLS (legacy)</option>
                    </select>
                    <span asp-validation-for="SslMode" class="text-danger"></span>
                </div>
                <div class="form-group span-2 connection-tls-ca" data-tls-ca-group hidden="@tlsDisabled">
                    <label asp-for="SslCa" class="form-label"></label>
                    <input asp-for="SslCa"
                           class="form-control"
                           autocomplete="off"
                           placeholder="/absolute/path/to/ca.pem"
                           required="@caRequired"
                           disabled="@tlsDisabled"
                           data-tls-ca-input />
                    <span asp-validation-for="SslCa" class="text-danger"></span>
                    <div class="form-text">Trusted PEM file on this computer; required for VerifyFull and VerifyCA.</div>
                </div>
                <div class="form-group span-2 connection-tls-risk" data-tls-risk-group hidden="@verifiedTls">
                    <div class="connection-tls-alert" role="status" aria-live="polite">
                        <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
                        <span data-tls-risk-message>@tlsRiskMessage</span>
                    </div>
                    <label class="connection-tls-consent" for="AcknowledgeInsecureTls">
                        <input asp-for="AcknowledgeInsecureTls" class="form-check-input" data-tls-risk-acknowledgment />
                        <span>I understand and accept this connection risk.</span>
                    </label>
                    <span asp-validation-for="AcknowledgeInsecureTls" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-check2"></i> @(isNew ? "Create connection" : "Save changes")
            </button>
        </div>
    </form>
</div>

@section Scripts
{
    <script src="~/js/connection-tls.js" asp-append-version="true"></script>
}
